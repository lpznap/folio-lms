{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Folio API (Docker)",
      "type": "coreclr",
      "request": "attach",
      "preLaunchTask": "Prepare Folio Docker debugger",
      "processId": "1",
      "targetArchitecture": "x86_64",
      "justMyCode": false,
      "requireExactSource": false,
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeArgs": ["compose", "-f", "${workspaceFolder}/compose.yaml", "exec", "-T", "api"],
        "pipeCwd": "${workspaceFolder}",
        "debuggerPath": "/remote_debugger/linux-x64/latest/vsdbg",
        "quoteArgs": false
      },
      "sourceFileMap": { "/src": "${workspaceFolder}/backend" },
      "logging": { "engineLogging": true, "moduleLoad": true, "exceptions": true }
    }
  ]
}
